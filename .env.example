# Postgres connection (DigitalOcean Managed Database or local)
DATABASE_URL=postgres://user:password@host:5432/allintanzania
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public address of the site, e.g. https://allintanzania.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# AI safari expert (Claude API)
ANTHROPIC_API_KEY=
# Optional: lower is faster and cheaper, higher thinks harder (low | medium | high)
EXPERT_EFFORT=low

# Voice (optional): ElevenLabs text-to-speech
ELEVENLABS_API_KEY=

# Photos on DigitalOcean Spaces (optional; local disk is used when empty)
S3_BUCKET=
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Dropbox photo sync (optional)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Staff can only browse inside this folder
DROPBOX_FOLDER=/AllinTanzania

# Enquiry emails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=website@allintanzania.com

# docker-compose (DigitalOcean Droplet)
# Password for the bundled Postgres container
POSTGRES_PASSWORD=
# Address Caddy serves with HTTPS. For testing use <droplet-ip>.sslip.io
SITE_DOMAIN=
# Optional: create the first admin when running the seed
SEED_ADMIN_EMAIL=
